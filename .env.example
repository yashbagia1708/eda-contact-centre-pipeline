# Copy to .env and adjust. Defaults match docker-compose.yml.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=eda
DB_PASSWORD=eda_pass
DB_NAME=contact_centre

# Where each month's source extracts land (one sub-folder per month, e.g. data/raw/2026-10/)
RAW_DIR=./data/raw

# Where the Power BI model workbook is written. Point this at a OneDrive folder so
# Power BI (web) picks up each refresh automatically, e.g. on a Mac:
# EXPORT_DIR=~/Library/CloudStorage/OneDrive-YourOrg/EDA_Contact_Centre/powerbi
EXPORT_DIR=./output/powerbi

# Monthly KPI pack (formatted Excel). Can also live in OneDrive.
REPORT_DIR=./output/reports

# Fail the run if any source rejects more than this share of its rows
MAX_REJECT_RATE=0.02

# Optional: what the Refresh Console's "Open Power BI to refresh" button opens, e.g. your semantic model's page in
# Power BI web (where "Refresh now" is). Left empty: the repo's .pbix in Power BI Desktop on Windows, else app.powerbi.com
POWERBI_URL=
